drawCentralLineVert:b=no
drawCentralLineHorz:b=yes
drawSightMask:b=yes
crosshairDistHorSizeMain:p2=0.03, 0.02
crosshairDistHorSizeAdditional:p2=0.012, 0.003
distanceCorrectionPos:p2=-0.2, -0.05
