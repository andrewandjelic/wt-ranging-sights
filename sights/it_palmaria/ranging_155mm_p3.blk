drawLines{
  line{line:p4=0, -6, 0, -1.5; move:b=no; thousandth:b=yes;}
  line{line:p4=-5.75, -0.41, -5.75, 6.34; move:b=yes; thousandth:b=yes;}
  line{line:p4=-5.75, -0.41, -4.75, -0.41; move:b=yes; thousandth:b=yes;}
